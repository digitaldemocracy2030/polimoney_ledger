# Ledger API (apps/api) の環境変数
# このファイルを apps/api/.env にコピーして値を設定する

# ポート（省略時 3723。Hub は 3722）
PORT=3723

# Supabase（Ledger 用プロジェクト A）
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=
# service_role キー（特権処理専用。API だけが持つ）
SUPABASE_SERVICE_ROLE_KEY=

# 実行環境（production / development）
APP_ENV=development

# Polimoney Hub API
HUB_API_URL_PROD=https://api.polimoney.dd2030.org
HUB_API_URL_DEV=http://localhost:3722
HUB_API_KEY_PROD=
HUB_API_KEY_DEV=

# CORS で許可する Web のオリジン（カンマ区切り）
CORS_ALLOWED_ORIGINS=http://localhost:3721
