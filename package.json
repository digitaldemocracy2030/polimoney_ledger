{
  "name": "polimoney-ledger-monorepo",
  "private": true,
  "workspaces": [
    "apps/web",
    "packages/shared"
  ],
  "scripts": {
    "dev:web": "npm run dev --workspace apps/web",
    "build:web": "npm run build --workspace apps/web",
    "start:web": "npm run start --workspace apps/web",
    "dev:api": "deno task --cwd apps/api dev",
    "check:api": "deno task --cwd apps/api check",
    "check:web": "npm run typecheck --workspace apps/web",
    "check": "npm run check:api && npm run check:web"
  },
  "volta": {
    "node": "22.23.5"
  }
}
